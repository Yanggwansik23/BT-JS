<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <title>Tính Năm Âm Lịch (Can Chi)</title>
  <style>
    body { font-family: Arial, sans-serif; max-width: 420px; margin: 40px auto; line-height: 1.6; }
    input { width: 100%; padding: 8px; margin: 5px 0 15px; box-sizing: border-box; font-size: 16px; }
    button { width: 100%; padding: 10px; background-color: #c82333; color: white; border: none; cursor: pointer; font-size: 16px; }
    button:hover { background-color: #a71d2a; }
    #ketQua { margin-top: 20px; padding: 15px; background-color: #fff5f5; border-left: 4px solid #c82333; display: none; }
  </style>
</head>
<body>

  <h2>Tra Cứu Năm Âm Lịch (Can Chi)</h2>

  <label for="namDuong">Nhập năm dương lịch:</label>
  <input type="number" id="namDuong" placeholder="Ví dụ: 2024, 2025, 2026...">

  <button onclick="hienThiNamAmLich()">Xem năm âm lịch</button>

  <div id="ketQua"></div>

  <script>
    const THIEN_CAN = [
      "Giáp", "Ất", "Bính", "Đinh", "Mậu",
      "Kỷ", "Canh", "Tân", "Nhâm", "Quý"
    ];

    const DIA_CHI = [
      "Tý", "Sửu", "Dần", "Mão", "Thìn", "Tỵ",
      "Ngọ", "Mùi", "Thân", "Dậu", "Tuất", "Hợi"
    ];

    function tinhCanChi(nam) {
      const can = THIEN_CAN[(nam + 6) % 10];
      const chi = DIA_CHI[(nam + 8) % 12];
      return `${can} ${chi}`;
    }

    function hienThiNamAmLich() {
      const giaTri = document.getElementById('namDuong').value.trim();
      const nam = Number(giaTri);
      const box = document.getElementById('ketQua');

      if (!giaTri || !Number.isInteger(nam) || nam <= 0) {
        alert("Vui lòng nhập năm dương lịch là số nguyên dương hợp lệ!");
        return;
      }

      const canChi = tinhCanChi(nam);
      box.style.display = 'block';
      box.innerHTML = `
        <p><strong>Năm dương lịch:</strong> ${nam}</p>
        <p><strong>Năm âm lịch (Can Chi):</strong> <span style="color:#c82333; font-size:1.2em; font-weight:bold;">${canChi}</span></p>
      `;
    }
  </script>

</body>
</html>
